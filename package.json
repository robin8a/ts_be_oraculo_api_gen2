{
  "name": "ts_be_oraculo_api_gen2",
  "version": "1.0.0",
  "description": "Amplify Gen 2 backend for TerraSacha Oraculo",
  "type": "module",
  "scripts": {
    "sandbox": "node scripts/ampx-with-sso.mjs sandbox --identifier oraculo",
    "sandbox:once": "node scripts/ampx-with-sso.mjs sandbox --once --identifier oraculo",
    "sandbox:delete": "node scripts/ampx-with-sso.mjs sandbox delete --identifier oraculo",
    "seed:satellite-topology": "node _001_SEED/seedSatelliteTopology.js",
    "seed:satellite-topology:dry": "node _001_SEED/seedSatelliteTopology.js --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.0",
    "@aws-amplify/backend-cli": "^1.10.0",
    "aws-cdk-lib": "^2.269.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "aws-amplify": "^6.20.0"
  }
}
